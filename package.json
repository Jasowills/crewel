{
  "name": "crewel",
  "version": "0.1.0",
  "description": "A mixed crew of coding agents, stitched together on one ticket board.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jasowills/crewel.git"
  },
  "homepage": "https://github.com/Jasowills/crewel#readme",
  "bugs": {
    "url": "https://github.com/Jasowills/crewel/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "cli",
    "crewel",
    "team",
    "opencode",
    "claude-code",
    "codex"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "crewel": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@opentui/core": "^0.5.8",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
